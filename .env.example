# Configuração de Ambiente - vierstudio SaaS
PORT=3000
NODE_ENV=development

# Conexão PostgreSQL (Opcional se usar DB em nuvem / EC2)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/vierstudio?sslmode=require

# Chave de Inteligência Artificial Gemini (Opcional - caso queira IA real do Google em vez do Smart Engine local)
# GEMINI_API_KEY=sua-chave-gemini-aqui
# OPENAI_API_KEY=sua-chave-openai-aqui

# Configurações de Envio SMTP (Opcional)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=sua-api-key
# SMTP_FROM="vierstudio <noreply@vierstudio.com.br>"
